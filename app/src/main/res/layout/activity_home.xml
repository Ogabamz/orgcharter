<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="28dp"
    android:paddingEnd="28dp"
    android:paddingBottom="12dp">

    <!-- today's one thing -->
    <TextView
        android:id="@+id/intention"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/serif_italic"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="20dp"
        android:textColor="@color/dim"
        android:textSize="16sp" />

    <TextClock
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:fontFamily="@font/serif_light"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:textColor="@color/fg"
        android:textSize="72sp" />

    <TextClock
        android:id="@+id/date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:fontFamily="@font/serif_regular"
        android:format12Hour="EEEE, d MMMM"
        android:format24Hour="EEEE, d MMMM"
        android:paddingTop="4dp"
        android:textColor="@color/dim"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/screenTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:fontFamily="@font/serif_regular"
        android:paddingTop="4dp"
        android:textColor="@color/dim"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/bedtime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:fontFamily="@font/serif_italic"
        android:paddingTop="12dp"
        android:text="bedtime · rest well"
        android:textColor="@color/dim"
        android:textSize="14sp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/appList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="16dp" />
    </ScrollView>

    <!-- verse of the day -->
    <TextView
        android:id="@+id/verse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/serif_italic"
        android:gravity="center"
        android:lineSpacingMultiplier="1.15"
        android:maxLines="4"
        android:textColor="@color/dim"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/verseRef"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:fontFamily="@font/serif_regular"
        android:paddingTop="4dp"
        android:textColor="@color/dim"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/focusStats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:fontFamily="@font/serif_regular"
        android:paddingTop="16dp"
        android:textColor="@color/dim"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- focus · notes · mono -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:paddingTop="4dp">

        <TextView
            android:id="@+id/focus"
            style="@style/BottomWord"
            android:text="focus" />

        <TextView
            style="@style/BottomDot" />

        <TextView
            android:id="@+id/notes"
            style="@style/BottomWord"
            android:text="notes" />

        <TextView
            style="@style/BottomDot" />

        <TextView
            android:id="@+id/mono"
            style="@style/BottomWord"
            android:text="mono" />
    </LinearLayout>
</LinearLayout>
